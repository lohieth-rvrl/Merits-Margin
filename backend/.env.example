# MongoDB Atlas connection string (see README for how to get this)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@yourcluster.mongodb.net/meritandmargin

# Your real deployed frontend URL, e.g. https://yourdomain.com -- restricts
# which site is allowed to call this API from a browser. Leave blank for
# local development (CORS will allow all origins, with a console warning).
FRONTEND_URL=

# Any long random string -- used to sign admin login tokens
JWT_SECRET=change-this-to-a-long-random-string

PORT=5000

# Used only once, by seed.js, to create your first admin login
SEED_ADMIN_EMAIL=you@example.com
SEED_ADMIN_PASSWORD=choose-a-strong-password

# --- Daily article automation (optional) ---
# Free key, no credit card required: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# This machine's own backend API base URL
API_URL=http://localhost:5000/api

# Current free-tier model. Check https://aistudio.google.com for the latest
# free model name if this one is ever retired.
GEMINI_MODEL=gemini-2.5-flash

# Optional. Free key from https://www.pexels.com/api/ -- enables real cover
# and in-body stock photos. Without it, the site's own generated category
# illustration is used instead.
PEXELS_API_KEY=

# Optional. Free key from Google Cloud Console -- enables the "Related
# video" section. Without this, that section is just skipped.
# See README for the 5-minute setup.
YOUTUBE_API_KEY=

# --- Optional: get notified when the daily automation creates a draft ---
# Slack: create a free Incoming Webhook in your workspace, paste its URL here.
SLACK_WEBHOOK_URL=

# Email (via Gmail): use an "App Password", not your real Gmail password --
# generate one at https://myaccount.google.com/apppasswords (requires
# 2-Step Verification to be turned on for your Google account, which is free).
EMAIL_TO=
EMAIL_FROM=
EMAIL_APP_PASSWORD=
