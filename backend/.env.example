# MongoDB Atlas connection string (see README for how to get this)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@yourcluster.mongodb.net/ledgerandroute

# Any long random string -- used to sign admin login tokens
JWT_SECRET=change-this-to-a-long-random-string

PORT=5000

# Used only once, by seed.js, to create your first admin login
SEED_ADMIN_EMAIL=you@example.com
SEED_ADMIN_PASSWORD=choose-a-strong-password
