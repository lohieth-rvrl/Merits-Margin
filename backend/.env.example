# MongoDB Atlas connection string (see README for how to get this)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@yourcluster.mongodb.net/ledgerandroute

# Any long random string -- used to sign admin login tokens
JWT_SECRET=change-this-to-a-long-random-string

PORT=5000

# Used only once, by seed.js, to create your first admin login
SEED_ADMIN_EMAIL=you@example.com
SEED_ADMIN_PASSWORD=choose-a-strong-password

# --- Daily article automation (optional) ---
# Free key, no credit card required: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# This machine's own backend API base URL
API_URL=http://localhost:5000/api

# Current free-tier model. Check https://aistudio.google.com for the latest
# free model name if this one is ever retired.
GEMINI_MODEL=gemini-2.5-flash

# Optional. Free key from Google Cloud Console -- enables the "Related
# video" section. Without this, that section is just skipped.
# See README for the 5-minute setup.
YOUTUBE_API_KEY=
