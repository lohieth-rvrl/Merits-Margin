<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}{% if title %} — {% endif %}{{ site.siteName }}</title>
  <meta name="description" content="{{ description or site.tagline }}">
  <meta property="og:title" content="{{ title or site.siteName }}">
  <meta property="og:description" content="{{ description or site.tagline }}">
  <meta property="og:type" content="website">
  <link rel="canonical" href="https://{{ site.domain }}{{ page.url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/style.css">
  <link rel="icon" href="data:,">
</head>
<body>
<header class="masthead">
  <div class="wrap">
    <a href="/" class="wordmark">Ledger <span>&amp;</span> Route</a>
    <button class="nav-toggle" aria-expanded="false" aria-label="Toggle menu">Menu</button>
    <ul class="nav">
      <li><a href="/"{% if page.url == "/" %} class="is-active"{% endif %}>Home</a></li>
      <li><a href="/finance/"{% if section == "finance" %} class="is-active"{% endif %}>Finance</a></li>
      <li><a href="/career/"{% if section == "career" %} class="is-active"{% endif %}>Career & Jobs</a></li>
      <li><a href="/news/"{% if section == "news" %} class="is-active"{% endif %}>Money News</a></li>
      <li><a href="/about/"{% if page.url == "/about/" %} class="is-active"{% endif %}>About</a></li>
    </ul>
  </div>
</header>

{{ content | safe }}

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>© 2026 {{ site.siteName }}. All rights reserved.</div>
    <ul class="footer-links">
      <li><a href="/about/">About</a></li>
      <li><a href="/contact/">Contact</a></li>
      <li><a href="/privacy/">Privacy Policy</a></li>
      <li><a href="/terms/">Terms</a></li>
    </ul>
  </div>
</footer>
<script src="/assets/js/main.js"></script>
</body>
</html>
